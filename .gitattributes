# Normalise to LF in the repository. Without this, a Windows checkout gives
# .claude/hooks/protect-main.sh CRLF line endings, and bash fails on the shebang —
# silently disabling main protection on exactly the machine that needs it.
* text=auto eol=lf

*.sh text eol=lf
*.png binary
*.jpg binary
*.mp3 binary

# Generated artifacts: keep them out of diffs and out of language statistics, but they
# are still tracked and still reviewed by count.
graphify-out/** linguist-generated=true
package-lock.json linguist-generated=true
